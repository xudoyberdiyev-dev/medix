{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Farmatsevtika ulgurji distribyutsiyasi ERP",
    "title" : "MEDIX API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Tizimga kirish va sessiya",
    "name" : "auth"
  } ],
  "paths" : {
    "/api/auth/csrf" : {
      "get" : {
        "description" : "XSRF-TOKEN cookie'sini o'rnatadi. Ilova ochilganda bir marta chaqiriladi.",
        "operationId" : "csrf",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CsrfResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "CSRF tokenini olish",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/login" : {
      "post" : {
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Tizimga kirish",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/me" : {
      "get" : {
        "operationId" : "me",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MeResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "Joriy foydalanuvchi",
        "tags" : [ "auth" ]
      }
    },
    "/api/auth/password" : {
      "post" : {
        "description" : "Birinchi kirishda majburiy.",
        "operationId" : "changePassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        },
        "summary" : "Parolni almashtirish",
        "tags" : [ "auth" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "type" : "object",
        "properties" : {
          "currentPassword" : {
            "type" : "string",
            "minLength" : 1
          },
          "newPassword" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 8
          }
        },
        "required" : [ "currentPassword", "newPassword" ]
      },
      "CsrfResponse" : {
        "type" : "object",
        "properties" : {
          "headerName" : {
            "type" : "string"
          },
          "token" : {
            "type" : "string"
          }
        },
        "required" : [ "headerName", "token" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "login" : {
            "type" : "string",
            "maxLength" : 64,
            "minLength" : 0
          },
          "password" : {
            "type" : "string",
            "maxLength" : 128,
            "minLength" : 0
          }
        },
        "required" : [ "login", "password" ]
      },
      "MeResponse" : {
        "type" : "object",
        "properties" : {
          "branchId" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Asosiy filial; null — biriktirilmagan"
          },
          "fullName" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "login" : {
            "type" : "string"
          },
          "mustChangePassword" : {
            "type" : "boolean"
          },
          "permissions" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "role" : {
            "$ref" : "#/components/schemas/RoleRef"
          }
        },
        "required" : [ "fullName", "id", "login", "mustChangePassword", "permissions", "role" ]
      },
      "RoleRef" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "name" ]
      }
    }
  }
}
