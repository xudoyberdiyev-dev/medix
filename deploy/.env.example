# MEDIX production muhiti. Nusxa: cp .env.example .env && chmod 600 .env — keyin qiymatlarni to'ldiring.
# .env repoga yozilmaydi (.gitignore).

# Domen (Caddy shu domen uchun Let's Encrypt sertifikatini o'zi oladi; DNS A yozuvi serverga qarashi kerak).
# Domen bo'lmasa (ofis ichki serveri): MEDIX_DOMAIN=medix.local va MEDIX_TLS=internal
MEDIX_DOMAIN=medix.example.uz
# Sertifikat xabarnomalari uchun email (Let's Encrypt). MEDIX_TLS=internal bo'lsa — ichki CA
MEDIX_TLS=admin@example.uz

# Image versiyasi (GitHub Release tegi, masalan v1.0.0). Yangilash: shu qiymatni o'zgartirib `docker compose pull && docker compose up -d`
MEDIX_VERSION=latest

# Baza paroli — kamida 24 belgi, tasodifiy (masalan: openssl rand -base64 32)
MEDIX_DB_PASSWORD=

# Birinchi ishga tushirishdagi CEO hisobi. Birinchi kirishda parol almashtiriladi; keyin bu qiymatlarni o'chirsa bo'ladi.
MEDIX_BOOTSTRAP_LOGIN=
MEDIX_BOOTSTRAP_PASSWORD=

# Backend xotirasi (konteyner chegarasi). 8 GB serverda 2g yetarli.
MEDIX_BACKEND_MEMORY=2g
